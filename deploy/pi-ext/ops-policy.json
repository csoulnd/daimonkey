{
  "version": 1,
  "repo_root": ".",
  "max_tool_calls": 60,
  "audit_dir": "data/ops-audit",
  "secret_paths": [
    "data/assistant.env",
    "data/assistant_secret",
    "data/update_password.sha256",
    ".ssh",
    ".git/config",
    ".pi"
  ],
  "writable_dirs": [
    "collector",
    "scripts",
    "templates",
    "static",
    "tests",
    "docs",
    "reports",
    "skills",
    "brand",
    "dist",
    "data/cache"
  ],
  "approval_dirs": [
    "deploy",
    "data",
    ".git",
    "requirements.txt",
    "AGENTS.md"
  ],
  "deny": [
    "\\brm\\s+-[rf]{1,2}\\s+/",
    "\\bmkfs",
    "\\bdd\\s+if=",
    "\\bshutdown\\b",
    "\\breboot\\b",
    "\\bpoweroff\\b",
    "\\binit\\s+0",
    "chmod\\s+-R\\s+777\\s+/",
    "curl[^|]*\\|\\s*(ba)?sh",
    "wget[^|]*\\|\\s*(ba)?sh",
    "\\b(cat|less|head|tail|grep|sed|awk)\\b[^\\n]*(assistant\\.env|assistant_secret|update_password|\\.ssh/)",
    "\\b(env|printenv)\\b",
    "/proc/[^\\s]*/environ",
    "\\bgit\\s+push\\s+.*--force",
    ">\\s*/dev/sd"
  ],
  "safe": [
    "ls",
    "cat",
    "head",
    "tail",
    "grep",
    "rg",
    "find",
    "wc",
    "du",
    "df",
    "ps",
    "free",
    "uptime",
    "pwd",
    "echo",
    "git status",
    "git diff",
    "git log",
    "git show",
    "git branch",
    "git rev-parse",
    "journalctl -u daimonkey",
    "systemctl status daimonkey",
    ".venv/bin/python -m unittest",
    ".venv/bin/python scripts/verify.py",
    ".venv/bin/pip list",
    "node --version",
    "python3 --version",
    "sqlite3 data/heat_index.sqlite 'select"
  ],
  "approval_required_always": [
    "sudo",
    "systemctl restart",
    "systemctl stop",
    "systemctl start",
    "systemctl daemon-reload",
    "python scripts/opsctl.py",
    ".venv/bin/python -m collector --update",
    ".venv/bin/python -m collector --build",
    "git commit",
    "git push",
    "git checkout",
    "git reset",
    "npm",
    "pip install",
    ".venv/bin/pip install"
  ]
}
