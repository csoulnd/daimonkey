# Python 运行时与虚拟环境
.venv/
__pycache__/
*.pyc

# 运行数据与生成产物（可由 --update / --build 重建，含密码哈希不入库）
data/
dist/

# 备份/恢复现场（含账号哈希与密钥，禁止入库）
backups/
data.pre-restore-*/
daimonkey-backup-*.tar.gz

# 环境检查报告（scripts/check_env.sh 生成）
env_report.md

# 降权后 HOME=仓库根：服务用户的 SSH key 与 pi 凭据/模型缓存（禁止入库）
.ssh/
.pi/

# 编辑器与系统文件
.DS_Store
*.swp
